# --- Database (Supabase Postgres connection string; server-side only) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rankpilot

# --- Auth ---
# Default: built-in email + password sign-in. On first visit, /sign-in shows
# "Set up your workspace" to create the agency and its admin account.
# Optional: use Supabase Auth instead — set AUTH_PROVIDER=supabase AND both keys below.
# (The keys alone do NOT switch the login method.)
AUTH_PROVIDER=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, local development only: AUTH_MODE=dev enables email-only sign-in
# (no password). Ignored when NODE_ENV=production.
AUTH_MODE=
# Required only for AUTH_MODE=dev. Generate with: openssl rand -hex 32
AUTH_SECRET=
# Supabase/dev modes: name of the agency created for the first user.
BOOTSTRAP_ORG_NAME=My Agency

# Workspace owner: the only email allowed to create the workspace, and the account
# that can set its first password on the sign-in page. Always an admin; cannot be
# removed, demoted, or have its password reset by other admins.
OWNER_EMAIL=ratulroydigital@gmail.com
# Optional: also require this code to set the owner password the first time.
OWNER_SETUP_CODE=

# --- Scheduler endpoint (e.g. Vercel Cron) ---
CRON_SECRET=

# --- SERP providers (server-side only, never exposed to the browser) ---
# Easiest: add keys in the app under Integrations (admins only). They are encrypted with
# APP_ENCRYPTION_KEY (generate: openssl rand -hex 32). Variables below are the fallback.
APP_ENCRYPTION_KEY=
YEPAPI_API_KEY=
# Google SERP is billed per page of 10 results (default 0.01 USD).
YEPAPI_PRICE_PER_PAGE=
YEPAPI_MAX_CONCURRENCY=3
YEPAPI_REQUESTS_PER_MINUTE=60
# Cost saving: minutes a fetched SERP is reused by identical searches (0 disables).
SERP_CACHE_MINUTES=30
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Your contracted price per Live Advanced SERP request. Leave blank if unknown;
# estimates are then shown as "unknown" instead of guessed.
DATAFORSEO_COST_PER_REQUEST=
DATAFORSEO_MAX_CONCURRENCY=5
DATAFORSEO_REQUESTS_PER_MINUTE=60

# Deterministic fake provider for local development and tests. Results are
# labelled provider "mock" everywhere. Never enable in production.
PROVIDER_MOCK_ENABLED=false

# --- Worker ---
WORKER_POLL_INTERVAL_MS=5000
WORKER_SCHEDULER_INTERVAL_MS=60000
