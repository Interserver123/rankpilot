{
  "name": "rankpilot",
  "version": "0.1.0",
  "private": true,
  "description": "RankPilot \u2014 SEO operations, local rank tracking and search intelligence",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/bundle-migrations.ts && opennextjs-cloudflare build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrations:bundle": "tsx scripts/bundle-migrations.ts",
    "predev": "tsx scripts/bundle-migrations.ts",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "build:next": "tsx scripts/bundle-migrations.ts && next build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "luxon": "^3.7.2",
    "next": "^15.5.28",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.7",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.152.0"
  }
}
