# --- Database (Supabase Postgres connection string; server-side only) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rankpilot

# --- Auth ---
# Default: built-in email + password sign-in. On first visit, /sign-in shows
# "Set up your workspace" to create the agency and its admin account.
# Optional: use Supabase Auth instead by setting both keys below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, local development only: AUTH_MODE=dev enables email-only sign-in
# (no password). Ignored when NODE_ENV=production.
AUTH_MODE=
# Required only for AUTH_MODE=dev. Generate with: openssl rand -hex 32
AUTH_SECRET=
# Supabase/dev modes: name of the agency created for the first user.
BOOTSTRAP_ORG_NAME=My Agency

# --- Scheduler endpoint (e.g. Vercel Cron) ---
CRON_SECRET=

# --- SERP providers (server-side only, never exposed to the browser) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Your contracted price per Live Advanced SERP request. Leave blank if unknown;
# estimates are then shown as "unknown" instead of guessed.
DATAFORSEO_COST_PER_REQUEST=
DATAFORSEO_MAX_CONCURRENCY=5
DATAFORSEO_REQUESTS_PER_MINUTE=60

# Deterministic fake provider for local development and tests. Results are
# labelled provider "mock" everywhere. Never enable in production.
PROVIDER_MOCK_ENABLED=false

# --- Worker ---
WORKER_POLL_INTERVAL_MS=5000
WORKER_SCHEDULER_INTERVAL_MS=60000
